---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import ImageFallback from '../components/ImageFallback.astro';
import Layout from './Layout.astro';
import {
	allRacesSameDay,
	formatDistance,
	getEarliestRaceDate,
	postedIsMeaningfullyLater,
} from '../utils/race-reports';

type Props = CollectionEntry<'race-reports'>['data'];

const {
	title,
	races,
	posted,
	dateApproximate,
	author,
	category,
	clubRace,
	heroImage,
	images,
	excerpt,
} = Astro.props;

const earliestRaceDate = getEarliestRaceDate(races);
const sameDay = allRacesSameDay(races);
const showPosted = postedIsMeaningfullyLater(posted, earliestRaceDate);
---

<Layout title={title} description={excerpt}>
	<article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
		<div class="aspect-[2/1] overflow-hidden rounded-box shadow-md">
			{heroImage ? (
				<Image width={1020} height={510} src={heroImage} alt="" class="h-full w-full object-cover" />
			) : (
				<ImageFallback />
			)}
		</div>
		<div class="prose py-8">
			<div class="mb-8 text-center">
				<div class="text-sm text-base-content/60">
					<span class="badge badge-secondary badge-outline">{category}</span>
					{clubRace && <span class="badge badge-secondary ml-2">Club race</span>}
				</div>
				<h1 class="mt-2">{title}</h1>
				<div class="text-sm text-base-content/60">
					{sameDay && <FormattedDate date={earliestRaceDate} approximate={dateApproximate} />}
					{author && <span> · {author}</span>}
				</div>
				{
					showPosted && (
						<div class="text-xs text-base-content/40 italic">
							Posted <FormattedDate date={posted!} />
						</div>
					)
				}
				<ul class="not-prose mt-4 flex flex-wrap justify-center gap-2">
					{races.map((race) => (
						<li class="badge badge-outline badge-lg gap-1 whitespace-normal py-4">
							<span class="font-semibold">{race.name}</span>
							{race.distance && <span>· {formatDistance(race.distance)}</span>}
							{!sameDay && (
								<span>
									· <FormattedDate date={race.raceDate} approximate={dateApproximate} />
								</span>
							)}
						</li>
					))}
				</ul>
				<hr class="border-base-300" />
			</div>
			<slot />
		</div>
		{
			images && images.length > 0 && (
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
					{images.map((img) => (
						<figure>
							<Image width={600} height={400} src={img.src} alt={img.alt} class="rounded-box shadow-md" />
							{img.alt && <figcaption class="mt-1 text-center text-sm text-base-content/60">{img.alt}</figcaption>}
						</figure>
					))}
				</div>
			)
		}
	</article>
</Layout>
