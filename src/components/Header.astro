---
import { NAV_LINKS, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="navbar bg-primary px-4 text-primary-content shadow-sm sm:px-6 lg:px-8">
	<div class="navbar-start">
		<div class="dropdown">
			<div tabindex="0" role="button" class="btn btn-ghost text-primary-content lg:hidden" aria-label="Open menu">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</div>
			<ul
				tabindex="0"
				class="menu dropdown-content menu-sm z-10 mt-3 w-52 rounded-box bg-primary p-2 text-primary-content shadow-lg"
			>
				{
					NAV_LINKS.map((link) => (
						<li>
							<HeaderLink href={link.href}>{link.label}</HeaderLink>
						</li>
					))
				}
			</ul>
		</div>
		<a
			href="/"
			class="btn btn-ghost px-2 text-lg font-semibold text-primary-content hover:text-secondary [font-family:var(--font-outfit)]"
		>
			{SITE_TITLE}
		</a>
	</div>
	<div class="navbar-end hidden lg:flex">
		<ul class="menu menu-horizontal gap-1 px-1">
			{
				NAV_LINKS.map((link) => (
					<li>
						<HeaderLink href={link.href}>{link.label}</HeaderLink>
					</li>
				))
			}
		</ul>
	</div>
</header>
