---
// The race diary: twelve months forward from the current one, grouped by month.
//
// The rule this page exists to hold: an entry whose date was computed from a
// rule NEVER shows a specific day. It gets "usually the last Sunday in
// November" instead. Only a date a human confirmed with the organiser, or a
// fixed date that cannot drift, earns a real one. Someone turning up a week
// late is a worse outcome than a page that admits what it does not know.
//
// Confirmed and approximate are told apart by wording, weight and a solid vs
// dashed rule — never by colour alone.
import { getCollection, render } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { formatDistance } from '../utils/distance';
import { getEarliestRaceDate, sortByRaceDateDesc } from '../utils/race-reports';
import {
	describeTiming,
	diaryCutoff,
	groupByMonth,
	hasExactDate,
	isRunning,
	monthName,
	nextOccurrence,
} from '../utils/race-diary';

const now = new Date();

const [events, reports] = await Promise.all([
	getCollection('calendar-events'),
	getCollection('race-reports', ({ data }) => !data.draft),
]);

// A race name in the diary matches the race name in a report's `races` array.
// That is what turns the archive into something useful rather than a list of
// dates, and it improves on its own every time somebody posts a report.
const reportsByRace = new Map<string, typeof reports>();
for (const report of reports) {
	for (const race of report.data.races) {
		const list = reportsByRace.get(race.name) ?? [];
		if (!list.includes(report)) list.push(report);
		reportsByRace.set(race.name, list);
	}
}

/**
 * Every report about a race, including under names it has since dropped.
 *
 * The Budleigh Blister was the Bicton Blister until Exmouth Harriers moved it,
 * and Bridgwater was written up twice, once per distance.
 * Matching on the current name alone would lose the 2017 report — the oldest
 * ones are exactly the ones a rename strands, and they are the ones nobody
 * would think to look for.
 */
const reportsFor = (entry: (typeof events)[number]) => {
	const seen = new Set<(typeof reports)[number]>();
	for (const name of [entry.data.name, ...entry.data.aliases]) {
		for (const report of reportsByRace.get(name) ?? []) seen.add(report);
	}
	return [...seen];
};

// Each entry's body: terrain, where it starts, whether the date has moved
// before. Rendered on the card because that is where somebody deciding whether
// to enter is looking — a note saying a race caps at 200 with no entries on
// the day is useless filed one click away.
const bodies = new Map(
	await Promise.all(
		events.map(async (event) => [event.id, (await render(event)).Content] as const),
	),
);

const cutoff = diaryCutoff(now, 12);

const months = groupByMonth(
	events
		.filter((event) => isRunning(event.data))
		.map((event) => ({ event, date: nextOccurrence(event.data, now) }))
		.filter((item): item is { event: (typeof events)[number]; date: Date } =>
			Boolean(item.date && item.date < cutoff),
		),
);
---

<div class="diary">
	{
		months.map(({ year, month, items }) => (
			<section class="diary-month">
				<h3 class="diary-month-heading">
					{monthName(month)} <span class="font-normal text-base-content/50">{year}</span>
				</h3>
				<ul class="mt-4 flex flex-col gap-3">
					{items.map(({ event, date }) => {
						const exact = hasExactDate(event.data, now);
						const related = sortByRaceDateDesc(reportsFor(event));
						const Body = bodies.get(event.id);
						return (
							<li class:list={['diary-entry', exact ? 'is-exact' : 'is-approximate']}>
								<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
									<h4 class="font-bold text-primary">{event.data.name}</h4>
									<div class="flex flex-wrap gap-1">
										{/* So somebody looking for the old name finds it, rather than
											    concluding their race has dropped out of the diary. */}
											{event.data.status === 'renamed' && event.data.aliases[0] && (
												<span class="badge badge-outline badge-sm">Was {event.data.aliases[0]}</span>
											)}
											{event.data.clubRace && <span class="badge badge-secondary badge-sm">Our race</span>}
										{event.data.championship && (
											<span class="badge badge-outline badge-sm">Championship</span>
										)}
									</div>
								</div>

								<p class="diary-when">
									{exact ? (
										<strong><FormattedDate date={date} /></strong>
									) : (
										describeTiming(event.data)
									)}
									{event.data.distances.length > 0 && (
										<span class="text-base-content/60">
											{' · '}
											{event.data.distances.map(formatDistance).join(' / ')}
										</span>
									)}
								</p>

								{/* Said in words as well as shown, so the difference does not rest
								    on the border style alone. */}
								<p class="diary-certainty">
									{exact ? 'Date confirmed' : 'Approximate — check before entering'}
								</p>

								{Body && (
									<div class="diary-note">
										<Body />
									</div>
								)}

								{related.length > 0 && (
									<p class="diary-reports">
										{related.map((report, index) => (
											<>
												{index > 0 && <span aria-hidden="true"> · </span>}
												<a href={`/race-reports/${report.id}/`} class="link link-primary">
													{getEarliestRaceDate(report.data.races).getUTCFullYear()} report
												</a>
											</>
										))}
									</p>
								)}
							</li>
						);
					})}
				</ul>
			</section>
		))
	}
</div>

<style>
	.diary-month + .diary-month {
		margin-top: 2.5rem;
	}

	.diary-month-heading {
		font-size: 1.35rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid var(--color-base-300);
	}

	/*
	  Solid rule for a date somebody checked, dashed for one worked out from a
	  rule. Shape rather than colour, so it survives being printed, and so it
	  does not depend on telling two blues apart.
	*/
	.diary-entry {
		padding: 0.75rem 0 0.75rem 1rem;
		border-left: 3px solid var(--color-base-300);
	}

	.diary-entry.is-exact {
		border-left-style: solid;
		border-left-color: var(--color-primary);
	}

	.diary-entry.is-approximate {
		border-left-style: dashed;
	}

	.diary-when {
		margin: 0.15rem 0 0;
	}

	.diary-certainty {
		margin: 0.1rem 0 0;
		font-size: 0.8rem;
		color: var(--color-base-content);
		opacity: 0.6;
	}

	/*
	  The body is Markdown, so it arrives wrapped in <p>. Global, because the
	  content comes from render() rather than from this file's own markup and
	  scoped styles would not reach it.
	*/
	.diary-note :global(p) {
		margin: 0.35rem 0 0;
		font-size: 0.875rem;
		color: var(--color-base-content);
		opacity: 0.75;
	}

	.diary-reports {
		margin: 0.35rem 0 0;
		font-size: 0.875rem;
	}
</style>
