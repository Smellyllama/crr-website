---
interface Props {
	heading: string;
	body: string;
}

const { heading, body } = Astro.props;
---

<section class="bg-base-200">
	<div class="mx-auto max-w-2xl px-4 py-12 text-center sm:px-6 lg:px-8">
		<h2 class="text-2xl font-bold text-base-content">{heading}</h2>
		<p class="mt-3 text-base-content/70">{body}</p>
	</div>
</section>
