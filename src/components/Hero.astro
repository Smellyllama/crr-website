---
import ContourBackdrop from './ContourBackdrop.astro';
import logoMark from '../assets/crr-logo-mark.svg?raw';

interface Cta {
	label: string;
	href: string;
}

interface Props {
	heading: string;
	strapline: string;
	primaryCta: Cta;
	secondaryCta: Cta;
}

const { heading, strapline, primaryCta, secondaryCta } = Astro.props;
---

<section id="hero" class="site-hero relative overflow-hidden bg-primary text-primary-content">
	<ContourBackdrop />
	<div class="hero-content relative mx-auto flex max-w-3xl flex-col items-center gap-8 px-4 text-center sm:px-6 lg:px-8">
		<div>
			{/*
			  The mark sits above the heading rather than replacing it: the club
			  name stays a real <h1>, per CLAUDE.md’s rule against text baked
			  into images. The mark reads "CRR", so it badges the hero without
			  repeating the name, which is why it is decorative here.
			*/}
			<div class="hero-logo mx-auto" aria-hidden="true" set:html={logoMark} />
			<h1 class="mt-6 text-4xl font-bold sm:text-5xl">{heading}</h1>
			<p class="mt-4 text-lg text-primary-content/80">{strapline}</p>
		</div>
		<div class="flex flex-col gap-3 sm:flex-row">
			<a href={primaryCta.href} class="btn btn-accent focus-visible:outline-white">
				{primaryCta.label}
			</a>
			<a
				href={secondaryCta.href}
				class="btn btn-outline border-primary-content/50 text-primary-content hover:bg-primary-content/10 hover:text-primary-content focus-visible:outline-white"
			>
				{secondaryCta.label}
			</a>
		</div>
	</div>
</section>

<style>
	/*
	  DELIBERATELY BORING. This hero rendered as contours alone on iOS Safari
	  until the first scroll, when the logo, heading and buttons appeared —
	  reproduced on two phones, on a device that had never loaded the site.

	  Two attempts to diagnose it from the outside failed, so the construction
	  is gone rather than adjusted. Both suspects are removed together:

	  1. The section was `display: flex`, making .hero-content a flex ROW item
	     with no width of its own. It is a plain block now, so its width is the
	     section's width and nothing has to be measured.
	  2. The height came from `clamp(28rem, 70svh, 44rem)`. A viewport unit on
	     iOS resolves against a toolbar that is still settling at first paint,
	     and is the usual suspect in "correct itself on scroll" bugs. The height
	     now comes from the content plus padding, so it cannot change when the
	     toolbar does.

	  The 404 page uses the same backdrop this way and has never done it.

	  If a viewport-height hero is ever wanted back, test it on a real iPhone
	  in Safari from a cold load, not in a desktop browser — nothing in a
	  desktop engine reproduces this.
	*/
	.site-hero {
		/* A floor, in rem, so a short strapline cannot squash it. Not vh. */
		min-height: 30rem;
	}

	.hero-content {
		/* Clears the fixed header, which is transparent over this section. */
		padding-top: calc(var(--header-height, 4rem) + 3.5rem);
		padding-bottom: 5.5rem;

		/* Above the contour layers explicitly rather than by DOM order. */
		z-index: 1;
	}

	@media (min-width: 640px) {
		.hero-content {
			padding-top: calc(var(--header-height, 4rem) + 4.5rem);
			padding-bottom: 7rem;
		}
	}

	/*
	  Chalk rather than the sky blue: the mark sits directly above the white
	  heading, and two near-white tones read as one badge, where sky would pull
	  attention off the h1. The sky blue does its work in the footer lockup.
	*/
	.hero-logo {
		width: min(18rem, 62%);
		color: var(--color-chalk);
	}

	.hero-logo :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
