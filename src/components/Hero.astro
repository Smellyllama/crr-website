---
import heroContoursDesktop from '../assets/hero-contours-desktop.svg?raw';
import heroContoursMobile from '../assets/hero-contours-mobile.svg?raw';
import logoMark from '../assets/crr-logo-mark.svg?raw';

interface Cta {
	label: string;
	href: string;
}

interface Props {
	heading: string;
	strapline: string;
	primaryCta: Cta;
	secondaryCta: Cta;
}

const { heading, strapline, primaryCta, secondaryCta } = Astro.props;
---

<section id="hero" class="site-hero relative overflow-hidden bg-primary text-primary-content">
	<div class="contours contours--desktop absolute inset-0 hidden sm:block" set:html={heroContoursDesktop} />
	<div class="contours contours--mobile absolute inset-0 sm:hidden" set:html={heroContoursMobile} />
	<div class="hero-content relative mx-auto flex max-w-3xl flex-col items-center justify-center gap-8 px-4 pb-16 text-center sm:px-6 lg:px-8">
		<div>
			{/*
			  The mark sits above the heading rather than replacing it: the club
			  name stays a real <h1>, per CLAUDE.md’s rule against text baked
			  into images. The mark reads "CRR", so it badges the hero without
			  repeating the name, which is why it is decorative here.
			*/}
			<div class="hero-logo mx-auto" aria-hidden="true" set:html={logoMark} />
			<h1 class="mt-6 text-4xl font-bold sm:text-5xl">{heading}</h1>
			<p class="mt-4 text-lg text-primary-content/80">{strapline}</p>
		</div>
		<div class="flex flex-col gap-3 sm:flex-row">
			<a href={primaryCta.href} class="btn btn-secondary focus-visible:outline-white">
				{primaryCta.label}
			</a>
			<a
				href={secondaryCta.href}
				class="btn btn-outline border-primary-content/50 text-primary-content hover:bg-primary-content/10 hover:text-primary-content focus-visible:outline-white"
			>
				{secondaryCta.label}
			</a>
		</div>
	</div>
</section>

<style>
	.site-hero {
		display: flex;
		min-height: clamp(28rem, 70svh, 44rem);
	}

	.hero-content {
		padding-top: var(--header-height, 4rem);
	}

	/*
	  Chalk rather than the sky blue: the mark sits directly above the white
	  heading, and two near-white tones read as one badge, where sky would pull
	  attention off the h1. The sky blue does its work in the footer lockup.
	*/
	.hero-logo {
		width: min(18rem, 62%);
		color: var(--color-chalk);
	}

	.hero-logo :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}

	.contours {
		/* Stroke colours are baked into the SVGs (#8AABC6 / #c5d6e6, both
		   already club secondary shades) — no currentColor to drive here. */
		opacity: 0.5;
	}

	.contours :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.contours--desktop :global(g) {
		stroke-width: 7;
	}

	.contours--mobile :global(g) {
		stroke-width: 9;
	}
</style>
