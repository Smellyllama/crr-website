---
interface Props {
	date: Date;
	// True when the exact day isn't known — render month and year only.
	approximate?: boolean;
}

const { date, approximate = false } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		approximate
			? date.toLocaleDateString('en-us', { year: 'numeric', month: 'long' })
			: date.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })
	}
</time>
