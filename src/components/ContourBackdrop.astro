---
// The LIDAR contour motif, as a backdrop. Used by the homepage hero and the
// 404 page, so the rules CLAUDE.md sets out for it live in one place rather
// than being copied and drifting.
//
// Both SVGs already carry aria-hidden and focusable="false" themselves, so
// there is nothing to add here for assistive tech.
//
// The parent must be `relative` and `overflow-hidden`: these fill it
// absolutely, and the SVGs use `slice` so they crop rather than letterbox.
import contoursDesktop from '../assets/hero-contours-desktop.svg?raw';
import contoursMobile from '../assets/hero-contours-mobile.svg?raw';

interface Props {
	/**
	 * How strongly the contours show, 0–1. Default 0.25.
	 *
	 * The default is the value that is safe to put words on, not the value that
	 * looks strongest, because the failure is silent: text over contours at 0.5
	 * looks fine and measures 3.29:1. Anyone adding a backdrop without thinking
	 * about it gets the readable one, and has to opt in to the louder setting
	 * for a band with nothing written on it.
	 *
	 * MEASURED, because this decides whether text on top is readable. The
	 * strokes are baked into the SVGs at #8AABC6 and #c5d6e6, and white text
	 * where the lighter one crosses a letter comes to:
	 *
	 *     0.5  → 4.13:1   fails AA for body text
	 *     0.4  → 5.37:1
	 *     0.25 → 8.01:1
	 *
	 * So anything carrying words stays at or below 0.25. Above that is for a
	 * band with no text on it, like ContourDivider.
	 */
	opacity?: number;
}

const { opacity = 0.25 } = Astro.props;
---

<div
	class="contours contours--desktop absolute inset-0 hidden sm:block"
	style={`opacity:${opacity}`}
	set:html={contoursDesktop}
/>
<div
	class="contours contours--mobile absolute inset-0 sm:hidden"
	style={`opacity:${opacity}`}
	set:html={contoursMobile}
/>

<style>
	.contours {
		/* Stroke colours are baked into the SVGs (#8AABC6 / #c5d6e6, both
		   already club secondary shades) — no currentColor to drive here. */
		/* Explicitly behind the content that sits on top of it, rather than
		   relying on DOM order alone. Decorative, so it never wants the tap
		   either. */
		z-index: 0;
		pointer-events: none;
	}

	.contours :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* The raw stroke-width of 2 computes to under a pixel once scaled and
	   disappears, so it is set here per breakpoint. */
	.contours--desktop :global(g) {
		stroke-width: 7;
	}

	.contours--mobile :global(g) {
		stroke-width: 9;
	}
</style>
