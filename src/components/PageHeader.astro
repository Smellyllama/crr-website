---
// The purple band at the top of an inside page.
//
// Five pages had this markup copied out — calendar, contact, results, join us,
// and the four legal pages through their shared template. Adding the contours
// meant touching all five the same way, which is the point at which a repeated
// block should stop being repeated.
//
// The contours come from ContourBackdrop at its default, which is the opacity
// that is safe to put words on. Do not raise it here: the strapline is 18px
// white at 80%, and that is the exact combination that measured 3.29:1 on the
// homepage hero before it was fixed.
//
// PAIR THIS WITH `overlayHeader` ON THE LAYOUT. The banner starts at the very
// top of the page and the header floats over it, so one SVG sits behind both
// the bar and the banner. Without that the bar is a separate purple block with
// its own slice of the pattern, and the two meet at a visible seam — which is
// what this looked like before, and no amount of adding contours to the bar
// fixes it, because two sliced copies of the same drawing do not line up.
//
// The top padding clears the floating header. A plain number, not a measured
// one, for the reason written on the hero: a value that has to be computed at
// runtime is a value that can be wrong at the moment it matters.
import ContourBackdrop from './ContourBackdrop.astro';

interface Props {
	heading: string;
	strapline?: string;
	/** Join Us centres its header; the rest are left-aligned. */
	center?: boolean;
}

const { heading, strapline, center = false } = Astro.props;
---

<section class="relative overflow-hidden bg-primary text-primary-content">
	<ContourBackdrop />
	<div
		class:list={[
			'relative z-1 mx-auto max-w-3xl px-4 pt-28 pb-14 sm:px-6 lg:px-8',
			center && 'text-center',
		]}
	>
		<h1 class="text-4xl font-bold sm:text-5xl">{heading}</h1>
		{strapline && <p class="mt-4 text-lg text-primary-content/80">{strapline}</p>}
	</div>
</section>
