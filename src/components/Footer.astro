---
import { ENGLAND_ATHLETICS_URL, FOOTER_PAGE_LINKS, SOCIAL_LINKS } from '../consts';

const year = new Date().getFullYear();
---

<footer class="bg-primary text-primary-content">
	<div class="footer sm:footer-horizontal mx-auto max-w-5xl gap-8 px-4 py-10 sm:px-6 lg:px-8">
		<nav>
			<h3 class="footer-title text-primary-content/70">Club</h3>
			{
				FOOTER_PAGE_LINKS.map((link) => (
					<a href={link.href} class="link link-hover text-primary-content hover:text-secondary">
						{link.label}
					</a>
				))
			}
		</nav>
		<nav>
			<h3 class="footer-title text-primary-content/70">Connect</h3>
			<a
				href={SOCIAL_LINKS.facebook}
				class="link link-hover text-primary-content hover:text-secondary"
				target="_blank"
				rel="noopener noreferrer"
			>
				Facebook
			</a>
			<a
				href={SOCIAL_LINKS.strava}
				class="link link-hover text-primary-content hover:text-secondary"
				target="_blank"
				rel="noopener noreferrer"
			>
				Strava
			</a>
			<a
				href={ENGLAND_ATHLETICS_URL}
				class="link link-hover text-primary-content hover:text-secondary"
				target="_blank"
				rel="noopener noreferrer"
			>
				England Athletics affiliated
			</a>
		</nav>
	</div>
	<div class="border-t border-primary-content/10 px-4 py-4 text-center text-sm text-primary-content/70">
		&copy; {year} Chard Road Runners
	</div>
</footer>
