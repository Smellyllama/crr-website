---
// Switches every distance on the site between miles and kilometres.
//
// The labels are the club's joke; the distances themselves always carry a real
// "mi" or "km" suffix, so nothing can be read as the wrong unit.
//
// The key and attribute names are passed as data attributes rather than with
// define:vars. define:vars forces the script inline, and inline in the middle
// of a daisyUI .menu it was rendered as visible text on the page.
import { UNIT_ATTRIBUTE, UNIT_STORAGE_KEY } from '../utils/distance';

const OPTIONS = [
	{ unit: 'mi', label: 'English Miles' },
	{ unit: 'km', label: 'Euro Miles' },
] as const;
---

<div
	class="unit-toggle"
	role="group"
	aria-label="Distance units"
	data-storage-key={UNIT_STORAGE_KEY}
	data-attribute={UNIT_ATTRIBUTE}
>
	{
		OPTIONS.map(({ unit, label }) => (
			<button type="button" data-unit={unit} aria-pressed="false">
				{label}
			</button>
		))
	}
</div>

<script>
	// The <head> script has already set the attribute before first paint. This
	// only handles clicks and keeps the pressed state in step. There are two
	// copies of the toggle — the hamburger and the desktop nav — so both are
	// updated whichever one is used.
	const groups = document.querySelectorAll<HTMLElement>('.unit-toggle');

	const sync = () => {
		const current = document.documentElement.getAttribute('data-units');
		groups.forEach((group) => {
			group.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
				button.setAttribute('aria-pressed', String(button.dataset.unit === current));
			});
		});
	};

	groups.forEach((group) => {
		const { storageKey, attribute } = group.dataset;
		group.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
			button.addEventListener('click', () => {
				const unit = button.dataset.unit;
				if (!unit || !attribute) return;
				document.documentElement.setAttribute(attribute, unit);
				try {
					if (storageKey) localStorage.setItem(storageKey, unit);
				} catch {
					// Private browsing, or storage disabled. The switch still works
					// for this visit; it just is not remembered.
				}
				sync();
			});
		});
	});

	sync();
</script>

<style>
	.unit-toggle {
		display: inline-flex;
		width: max-content;
		gap: 0.15rem;
		padding: 0.15rem;
		border: 1px solid color-mix(in srgb, var(--color-primary-content) 30%, transparent);
		border-radius: var(--radius-field);
	}

	.unit-toggle button {
		padding: 0.3rem 0.55rem;
		border: 0;
		border-radius: calc(var(--radius-field) - 1px);
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.75rem;
		line-height: 1.2;
		white-space: nowrap;
		cursor: pointer;
	}

	/* The chosen unit is filled. Pale blue on the purple bar, which the palette
	   rules allow for accents and text on dark. */
	.unit-toggle button[aria-pressed='true'] {
		background: var(--color-secondary);
		color: var(--color-secondary-content);
		font-weight: 600;
	}

	.unit-toggle button:focus-visible {
		outline: 2px solid white;
		outline-offset: 2px;
	}
</style>
