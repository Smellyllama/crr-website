---
// One race distance, rendered in both units. CSS on <html data-units="…">
// shows one and hides the other, so switching is instant and nothing shifts.
//
// Both are always in the DOM. The hidden one needs no aria-hidden: display
// none already takes it out of the accessibility tree, so a screen reader
// reads one distance, not two.
import { formatBothUnits, type Unit } from '../utils/distance';

interface Props {
	distance: { value: number; unit: Unit };
}

const { distance } = Astro.props;
const both = formatBothUnits(distance);
---

<span class="distance">
	<span class="distance-value" data-unit="mi">{both.mi}</span><span
		class="distance-value"
		data-unit="km">{both.km}</span
	>
</span>

<style>
	/*
	  Unlayered on purpose. Astro scoped styles are unlayered anyway, but the
	  point stands: nothing should be able to reveal both units at once.
	*/
	.distance-value {
		display: none;
	}

	:global(html[data-units='mi']) .distance-value[data-unit='mi'],
	:global(html[data-units='km']) .distance-value[data-unit='km'] {
		display: inline;
	}
</style>
