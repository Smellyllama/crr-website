---
import RaceDiary from '../components/RaceDiary.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Results" description="The club race diary, plus championship, handicap and records to come.">
	<section class="bg-primary text-primary-content">
		<div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
			<h1 class="text-4xl font-bold sm:text-5xl">Results</h1>
			<p class="mt-4 text-lg text-primary-content/80">
				The races members are heading for, and what they wrote about them last time.
			</p>
		</div>
	</section>

	<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
		<section id="race-calendar" class="scroll-mt-20">
			<h2 class="text-2xl font-bold text-primary">Race calendar</h2>
			<p class="mt-3 text-base-content/80">
				Races the club runs, twelve months ahead. Most dates are worked out from the last time we
				ran them, so they show as approximate — check with the organiser before entering. Where a
				date has been confirmed, it says so.
			</p>
			<div class="mt-8">
				<RaceDiary />
			</div>
		</section>

		<section class="mt-14 border-t border-base-300 pt-8">
			<h2 class="text-2xl font-bold text-primary">Championship, handicap and records</h2>
			<p class="mt-3 text-base-content/80">Still to come.</p>
		</section>
	</div>
</Layout>
