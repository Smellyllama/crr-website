---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/Layout.astro';
const posts = (await getCollection('race-reports', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.raceDate.valueOf() - a.data.raceDate.valueOf(),
);
---

<Layout title="Race Reports" description="Race reports and club news from Chard Road Runners.">
	<section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
		<ul class="grid grid-cols-1 gap-8 sm:grid-cols-2">
			{
				posts.map((post, index) => (
					<li class:list={[{ 'sm:col-span-2': index === 0 }]}>
						<a href={`/race-reports/${post.id}/`} class="group block">
							{post.data.heroImage && (
								<Image
									width={720}
									height={360}
									src={post.data.heroImage}
									alt=""
									class="mb-2 rounded-box"
								/>
							)}
							<h4 class:list={['font-bold text-base-content group-hover:text-secondary', index === 0 ? 'text-3xl' : 'text-xl']}>
								{post.data.title}
							</h4>
							<p class="text-base-content/60 group-hover:text-secondary">
								<FormattedDate date={post.data.raceDate} approximate={post.data.dateApproximate} />
							</p>
							<p class="mt-1 text-base-content/70">{post.data.excerpt}</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
