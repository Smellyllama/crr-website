---
// SCRATCH PAGE — deleted before this branch becomes a PR.
//
// The footer column labels were <h3> with no size class, so they inherited the
// base heading scale at 30px. Taking them out of the heading tree means
// choosing a size deliberately. This is the choice, side by side, in the real
// footer's colours and type.
import ContourBackdrop from '../components/ContourBackdrop.astro';
import Layout from '../layouts/Layout.astro';
import { FOOTER_PAGE_LINKS, SOCIAL_LINKS } from '../consts';

const options = [
	{ id: 'a', label: 'A · 30px', note: 'as live today — inherited h3 size', size: '1.875rem' },
	{ id: 'b', label: 'B · 18px', note: 'text-lg', size: '1.125rem' },
	{ id: 'c', label: 'C · 14px', note: 'text-sm — what the brief asks for', size: '0.875rem' },
];
---

<Layout title="Footer label size" description="scratch">
	<div class="mx-auto max-w-full px-3 py-4">
		<h1 class="text-2xl font-bold text-primary">Footer column labels</h1>
		<p class="mt-1 text-sm text-base-content/70">
			Real footer markup, colours and links. Only the label size differs.
		</p>

		<div class="mt-5 grid grid-cols-3 gap-3">
			{
				options.map((o) => (
					<div class="overflow-hidden rounded border border-base-300">
						<div class="bg-base-200 px-3 py-2 text-xs">
							<strong>{o.label}</strong>
							<div class="text-base-content/60">{o.note}</div>
						</div>
						<div class="relative overflow-hidden bg-primary text-primary-content">
							<ContourBackdrop />
							<div class="relative z-1 px-4 py-6">
								<p
									class="footer-title font-semibold tracking-wide uppercase text-primary-content/70"
									style={`font-size:${o.size}`}
								>
									Club
								</p>
								<div class="mt-1 flex flex-col gap-1">
									{FOOTER_PAGE_LINKS.map((link) => (
										<a href={link.href} class="link link-hover text-sm text-primary-content">
											{link.label}
										</a>
									))}
								</div>

								<p
									class="footer-title mt-6 font-semibold tracking-wide uppercase text-primary-content/70"
									style={`font-size:${o.size}`}
								>
									Connect
								</p>
								<div class="mt-1 flex flex-col gap-1">
									<a href={SOCIAL_LINKS.facebook} class="link link-hover text-sm text-primary-content">Facebook</a>
									<a href={SOCIAL_LINKS.strava} class="link link-hover text-sm text-primary-content">Strava</a>
								</div>
							</div>
						</div>
					</div>
				))
			}
		</div>

		<p class="mt-5 text-sm text-base-content/70">
			The links are 14px in all three. In A the label is more than twice the size
			of the links it labels; in C it matches them and is told apart by weight,
			case and spacing instead.
		</p>
	</div>
</Layout>
