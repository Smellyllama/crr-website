---
import Layout from '../layouts/Layout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="relative overflow-hidden bg-primary text-primary-content">
		<img
			src="/hero-contours-desktop.svg"
			alt=""
			class="pointer-events-none absolute inset-0 hidden h-full w-full object-cover opacity-30 sm:block"
		/>
		<img
			src="/hero-contours-mobile.svg"
			alt=""
			class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-30 sm:hidden"
		/>
		<div class="relative mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 lg:px-8">
			<h1 class="text-4xl font-bold sm:text-5xl">Chard Road Runners</h1>
			<p class="mt-4 text-lg text-primary-content/80">{SITE_DESCRIPTION}</p>
		</div>
	</section>
	<section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 lg:px-8">
		<p class="text-lg text-base-content/70">
			The layout shell is in place — header, nav and footer. Home page content is next.
		</p>
	</section>
</Layout>
