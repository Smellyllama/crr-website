---
import Layout from '../layouts/Layout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 lg:px-8">
		<h1 class="text-4xl font-bold text-primary sm:text-5xl">Chard Road Runners</h1>
		<p class="mt-4 text-lg text-base-content/70">
			The layout shell is in place — header, nav and footer. Home page content is next.
		</p>
	</section>
</Layout>
