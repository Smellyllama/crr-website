---
import { getEntry } from 'astro:content';
import ClubNights from '../components/ClubNights.astro';
import ComingUp from '../components/ComingUp.astro';
import CouchTo5k from '../components/CouchTo5k.astro';
import Handicap from '../components/Handicap.astro';
import Hero from '../components/Hero.astro';
import LatestRaceReports from '../components/LatestRaceReports.astro';
import OurRaces from '../components/OurRaces.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Layout from '../layouts/Layout.astro';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');

const { hero, clubNights, handicap, couchTo5k, latestReports, upcoming, ourRaces } = home.data;
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} overlayHeader>
	<Hero {...hero} />
	<ClubNights {...clubNights} />
	<Handicap {...handicap} />
	<CouchTo5k {...couchTo5k} />
	<LatestRaceReports {...latestReports} />
	<ComingUp {...upcoming} />
	<OurRaces {...ourRaces} />
</Layout>
